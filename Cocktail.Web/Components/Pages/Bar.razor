@page "/bar"
@rendermode InteractiveServer
@using Cocktail.Web.Data
@using Cocktail.Web.Services
@implements IAsyncDisposable
@inject RecipeService Recipes
@inject IJSRuntime JS

<PageTitle>Sangria · My Bar</PageTitle>

<div class="main">
    <div class="page-head">
        <div>
            <h1 class="page-title">Your <em>shelf</em></h1>
            <div class="page-sub">Tap any bottle to mark it in stock · voice: "add mezcal"</div>
        </div>
        <button class="btn @(listening ? "btn-papaya" : "btn-ghost")" type="button" @onclick="ToggleListening">
            <AppIcon Name="mic" CssClass="" Size="14" />
            @(listening ? "Listening" : "Voice mode")
        </button>
    </div>

    @if (lastHeard is not null)
    {
        <div class="heard">Heard: <em>@lastHeard</em>@(string.IsNullOrEmpty(lastAction) ? "" : " — " + lastAction)</div>
    }
    @if (errorText is not null)
    {
        <div class="error">@errorText</div>
    }

    <div class="stat-row">
        <div class="bar-stat">
            <span class="bar-stat-num">@stats.BottlesInStock<span class="small">/@stats.BottlesTotal</span></span>
            <span class="bar-stat-label">Bottles in stock</span>
        </div>
        <div class="bar-stat">
            <span class="bar-stat-num"><em>@stats.ReadyToMake</em></span>
            <span class="bar-stat-label">Drinks ready to make</span>
        </div>
        <div class="bar-stat">
            <span class="bar-stat-num">@stats.OneBottleAway</span>
            <span class="bar-stat-label">One bottle away</span>
        </div>
        <div class="bar-stat">
            <span class="bar-stat-num">12</span>
            <span class="bar-stat-label">Made this month</span>
        </div>
    </div>

    @if (stats.OneBottleAway > 0)
    {
        <div class="tip-card" style="grid-template-columns: auto 1fr auto">
            <div class="tip-icon" style="background: var(--lime); color: var(--jungle)">
                <AppIcon Name="plus" CssClass="" Size="22" />
            </div>
            <div>
                <h3 class="tip-title">One bottle from @stats.OneBottleAway more drinks</h3>
                <p class="tip-sub">The shopping list ranks bottles by what they unlock.</p>
            </div>
            <a class="btn btn-ghost" href="/shopping">View shopping list <AppIcon Name="arrowright" CssClass="" Size="14" /></a>
        </div>
    }

    <form class="toolbar add-form" @onsubmit="AddItem" @onsubmit:preventDefault="true">
        <div class="search">
            <AppIcon Name="search" CssClass="" Size="18" />
            <input type="search" placeholder="Search the shelf…" value="@query" @oninput="OnQueryChanged" />
        </div>
        <input class="text-input" placeholder="New bottle (e.g. Mezcal)" @bind="newItem" />
        <select class="cat-select" @bind="newCategory">
            @foreach (var cat in CATEGORIES)
            {
                <option value="@cat">@cat</option>
            }
        </select>
        <button class="btn btn-papaya" type="submit"><AppIcon Name="plus" CssClass="" Size="14" /> Add bottle</button>
    </form>

    <div class="filter-row">
        @foreach (var c in cats)
        {
            var id = c;
            var count = id == "all" ? items.Count : items.Count(i => i.Category == id);
            <button type="button" class="chip @(filter == id ? "on" : "")" @onclick="() => SetFilter(id)">
                @(id == "all" ? "Everything" : id) <span style="opacity:0.5; font-size:11px; margin-left:4px">@count</span>
            </button>
        }
    </div>

    @if (filter == "all")
    {
        @foreach (var cat in cats.Where(c => c != "all"))
        {
            var inCat = items.Where(i => i.Category == cat && Matches(i)).ToList();
            if (inCat.Count == 0) continue;
            <div style="margin-bottom: 28px">
                <div class="section-head">
                    <h3 class="section-title">@cat</h3>
                    <span class="section-sub">@inCat.Count(i => i.InStock) of @inCat.Count</span>
                </div>
                <div class="shelf">
                    @foreach (var item in inCat)
                    {
                        var iid = item.Id;
                        <button type="button" class="bottle @(item.InStock ? "have" : "missing")" @onclick="() => Toggle(iid)">
                            <div class="bottle-check">
                                @if (item.InStock) { <AppIcon Name="check" CssClass="" Size="11" /> }
                            </div>
                            <div>
                                <div class="bottle-name">@item.IngredientName</div>
                                <div class="bottle-cat">@item.Category</div>
                            </div>
                        </button>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="shelf">
            @foreach (var item in items.Where(i => i.Category == filter && Matches(i)))
            {
                var iid = item.Id;
                <button type="button" class="bottle @(item.InStock ? "have" : "missing")" @onclick="() => Toggle(iid)">
                    <div class="bottle-check">
                        @if (item.InStock) { <AppIcon Name="check" CssClass="" Size="11" /> }
                    </div>
                    <div>
                        <div class="bottle-name">@item.IngredientName</div>
                        <div class="bottle-cat">@item.Category</div>
                    </div>
                </button>
            }
        </div>
    }

    @if (ready.Count > 0)
    {
        <div class="section-head" style="margin-top: 40px">
            <h2 class="section-title">Ready to <em>pour</em></h2>
            <span class="section-sub">@ready.Count drinks · zero shopping</span>
        </div>
        <div class="grid">
            @foreach (var r in ready.Take(8))
            {
                <RecipeCard Recipe="r" />
            }
        </div>
    }
</div>

@code {
    static readonly string[] CATEGORIES = new[]
    {
        "Spirit", "Bitter", "Fortified", "Liqueur", "Bitters", "Syrup", "Mixer", "Fresh", "Other",
    };

    List<BarItem> items = new();
    List<string> cats = new() { "all" };
    List<RecipeListItem> ready = new();
    BarStats stats = new(0, 0, 0, 0);

    string filter = "all";
    string query = "";
    string newItem = "";
    string newCategory = "Spirit";

    bool listening;
    string? lastHeard;
    string? lastAction;
    string? errorText;
    DotNetObjectReference<Bar>? selfRef;

    protected override Task OnInitializedAsync() => Refresh();

    async Task Refresh()
    {
        items = await Recipes.GetBarItemsAsync(CancellationToken.None);
        cats = new[] { "all" }
            .Concat(items.Select(i => i.Category).Distinct().OrderBy(c => c))
            .ToList();
        stats = await Recipes.GetBarStatsAsync(CancellationToken.None);
        ready = await Recipes.SearchAsync(new RecipeSearch { OnlyMakeable = true }, CancellationToken.None);
    }

    bool Matches(BarItem i) =>
        string.IsNullOrEmpty(query)
        || i.IngredientName.Contains(query, StringComparison.OrdinalIgnoreCase);

    void SetFilter(string id) => filter = id;

    void OnQueryChanged(ChangeEventArgs e) => query = e.Value?.ToString() ?? "";

    async Task Toggle(int id)
    {
        await Recipes.ToggleBarItemAsync(id, CancellationToken.None);
        await Refresh();
    }

    async Task AddItem()
    {
        if (string.IsNullOrWhiteSpace(newItem)) return;
        await Recipes.AddBarItemAsync(newItem, newCategory, CancellationToken.None);
        newItem = "";
        await Refresh();
    }

    async Task ToggleListening()
    {
        if (listening) await StopListening();
        else await StartListening();
    }

    async Task StartListening()
    {
        selfRef ??= DotNetObjectReference.Create(this);
        var ok = await JS.InvokeAsync<bool>("speech.startRecognition", selfRef, "en-US");
        if (!ok)
        {
            errorText = "Speech recognition is not available. Try Chrome or Edge over HTTPS.";
            return;
        }
        listening = true;
        errorText = null;
        await JS.InvokeVoidAsync("speech.speak", "Voice mode on. Say add or remove.", "en-US", 1.0);
    }

    async Task StopListening()
    {
        await JS.InvokeVoidAsync("speech.stopRecognition");
        await JS.InvokeVoidAsync("speech.cancelSpeech");
        listening = false;
    }

    [JSInvokable]
    public async Task OnSpeechHeard(string transcript)
    {
        lastHeard = transcript;
        lastAction = null;
        var intent = VoiceParser.Parse(transcript);

        switch (intent)
        {
            case AddIngredientIntent add:
                await Recipes.SetBarItemStockAsync(add.IngredientName, true, CancellationToken.None);
                lastAction = $"added {add.IngredientName}";
                await Refresh();
                await JS.InvokeVoidAsync("speech.speak", $"Added {add.IngredientName}.", "en-US", 1.0);
                break;

            case RemoveIngredientIntent remove:
                await Recipes.SetBarItemStockAsync(remove.IngredientName, false, CancellationToken.None);
                lastAction = $"removed {remove.IngredientName}";
                await Refresh();
                await JS.InvokeVoidAsync("speech.speak", $"Removed {remove.IngredientName}.", "en-US", 1.0);
                break;

            case PauseTtsIntent:
                await JS.InvokeVoidAsync("speech.cancelSpeech");
                lastAction = "stopped speaking";
                break;

            default:
                lastAction = "no match — try \"add\" or \"remove\"";
                break;
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnSpeechError(string error)
    {
        if (error is "not-allowed" or "service-not-allowed")
        {
            errorText = "Microphone permission denied.";
            listening = false;
        }
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnSpeechStopped()
    {
        listening = false;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("speech.stopRecognition");
            await JS.InvokeVoidAsync("speech.cancelSpeech");
        }
        catch { /* circuit may already be gone */ }
        selfRef?.Dispose();
    }
}
