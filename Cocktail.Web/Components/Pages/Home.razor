@page "/"
@rendermode InteractiveServer
@inject Cocktail.Web.Services.RecipeService Recipes
@inject NavigationManager Nav

<PageTitle>Cocktails</PageTitle>

<h1>Cocktails</h1>

@if (results is not null)
{
    var ready = results.Count(r => r.MissingIngredients.Count == 0);
    <div class="ready-banner @(ready > 0 ? "" : "empty")">
        @if (ready > 0)
        {
            <strong>🍸 @ready @(ready == 1 ? "drink" : "drinks") ready to make</strong>
            @if (!onlyMakeable)
            {
                <button class="btn-link" @onclick="() => SetMakeable(true)">Show only these</button>
            }
            else
            {
                <button class="btn-link" @onclick="() => SetMakeable(false)">Show all recipes</button>
            }
        }
        else
        {
            <span>No drinks ready yet — stock more bottles on the <a href="/bar">Bar</a> page or check the <a href="/shopping">Shopping</a> list.</span>
        }
    </div>
}

<div class="toolbar">
    <input type="search"
           placeholder="Search by name or ingredient"
           value="@query"
           @oninput="OnQueryChanged"
           class="search" />
    <label class="toggle">
        <input type="checkbox" checked="@onlyMakeable" @onchange="OnMakeableToggled" />
        Only what I can make now
    </label>
</div>

@if (results is null)
{
    <p><em>Loading…</em></p>
}
else if (results.Count == 0)
{
    <p>No matching recipes.</p>
}
else
{
    <ul class="recipe-list">
        @foreach (var r in results)
        {
            <li class="recipe-card" @onclick="() => Open(r.Id)">
                <h3>@r.Name</h3>
                <div class="meta">@r.Method · @r.Glassware</div>
                @if (r.MissingIngredients.Count > 0)
                {
                    <div class="missing">Missing: @string.Join(", ", r.MissingIngredients)</div>
                }
                else
                {
                    <div class="ready">Ready to make</div>
                }
            </li>
        }
    </ul>
}

@code {
    [SupplyParameterFromQuery] public bool Makeable { get; set; }

    string query = "";
    bool onlyMakeable;
    List<Cocktail.Web.Services.RecipeListItem>? results;

    protected override Task OnInitializedAsync()
    {
        onlyMakeable = Makeable;
        return Refresh();
    }

    async Task OnQueryChanged(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        await Refresh();
    }

    async Task OnMakeableToggled(ChangeEventArgs e)
    {
        onlyMakeable = e.Value is true;
        await Refresh();
    }

    async Task SetMakeable(bool value)
    {
        onlyMakeable = value;
        await Refresh();
    }

    async Task Refresh()
    {
        results = await Recipes.SearchAsync(query, onlyMakeable, CancellationToken.None);
    }

    void Open(int id) => Nav.NavigateTo($"/recipe/{id}");
}
