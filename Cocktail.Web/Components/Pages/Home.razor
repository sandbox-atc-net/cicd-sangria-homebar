@page "/"
@rendermode InteractiveServer
@using Cocktail.Web.Services
@inject RecipeService Recipes
@inject NavigationManager Nav

<PageTitle>Sangria · Discover</PageTitle>

<div class="main">
    <div class="page-head">
        <div>
            <h1 class="page-title">Aloha, <em>bartender</em>.</h1>
            <div class="page-sub">
                @stats.BottlesInStock bottles on the shelf · @stats.ReadyToMake drinks ready
            </div>
        </div>
        <button class="btn btn-papaya" type="button" @onclick="GoMixer">
            <AppIcon Name="mic" CssClass="" Size="14" /> Hands-free mode
        </button>
    </div>

    @if (featured is not null)
    {
        <div class="hero-card" @onclick="OpenFeatured">
            <div>
                <div class="hero-eyebrow">Drink of the day · stirred since 1944</div>
                <h2>The original @featured.Name</h2>
                <p>@featured.Description</p>
                <div class="hero-cta-row">
                    <button class="btn" style="background: rgba(255,255,255,0.95); color: var(--ink)"
                            type="button" @onclick:stopPropagation="true" @onclick="MixFeatured">
                        <AppIcon Name="mic" CssClass="" Size="14" /> Make it hands-free
                    </button>
                    <a class="btn btn-ghost" href="@FeaturedHref" style="border-color: rgba(255,255,255,0.4); color: white"
                       @onclick:stopPropagation="true">
                        See recipe <AppIcon Name="arrowright" CssClass="" Size="14" />
                    </a>
                </div>
            </div>
            <div class="hero-glass">
                <GlassSvg Glass="@featured.Glass" Liquid="@featured.ColorHex" Garnish="flower" />
            </div>
        </div>
    }

    <div class="toolbar">
        <div class="search">
            <AppIcon Name="search" CssClass="" Size="18" />
            <input type="search" placeholder="Search recipes or ingredients — try 'rum and lime'…"
                   value="@query" @oninput="OnQueryChanged" />
            <span class="search-key">⌘K</span>
        </div>
        <button class="chip @(makeableOnly ? "on" : "")" type="button" @onclick="ToggleMakeable">
            <span class="chip-dot"></span> What I can make now
        </button>
    </div>

    <div class="discover-panel">
        <div class="discover-row">
            <div class="discover-label">Taste</div>
            <div class="taste-row">
                @foreach (var t in TASTE_FILTERS)
                {
                    var id = t.Id;
                    <button type="button"
                            class="taste-chip @(tastes.Contains(id) ? "on" : "")"
                            @onclick="() => ToggleTaste(id)">
                        <span class="taste-icon" aria-hidden="true">@t.Icon</span>
                        <span>@t.Label</span>
                    </button>
                }
            </div>
        </div>
        <div class="discover-row">
            <div class="discover-label">Color</div>
            <div class="color-row">
                @foreach (var c in RecipeService.ColorFamilies)
                {
                    var id = c.Id;
                    <button type="button"
                            class="color-chip @(color == id ? "on" : "")"
                            @onclick="() => ToggleColor(id)">
                        <span class="color-swatch" style="background: @c.Swatch"></span>
                        <span>@c.Label</span>
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="filter-row">
        @foreach (var f in FAMILY_FILTERS)
        {
            var id = f.Id;
            <button type="button" class="chip @(family == id ? "on" : "")" @onclick="() => SetFamily(id)">
                @f.Label
            </button>
        }
        @if (ActiveCount > 0)
        {
            <button type="button" class="chip" style="margin-left: auto; color: var(--bitters)" @onclick="ClearFilters">
                Clear @ActiveCount
            </button>
        }
    </div>

    <div class="section-head">
        <h2 class="section-title">Tonight's <em>shortlist</em></h2>
        <span class="section-sub">@(results?.Count ?? 0) recipe@(results?.Count == 1 ? "" : "s")</span>
    </div>

    @if (results is null)
    {
        <p><em>Loading…</em></p>
    }
    else if (results.Count == 0)
    {
        <div class="tip-card">
            <div class="tip-icon">🍃</div>
            <div>
                <h3 class="tip-title">Nothing matches that combo</h3>
                <p class="tip-sub">Try loosening a filter — or browse <strong>refreshing</strong> alone for a longer list.</p>
            </div>
            <button class="btn btn-ghost" type="button" @onclick="ClearFilters">Reset filters</button>
        </div>
    }
    else
    {
        <div class="grid">
            @foreach (var r in results)
            {
                <RecipeCard Recipe="r" />
            }
        </div>
    }
</div>

@code {
    record TasteFilter(string Id, string Label, string Icon);
    record FamilyFilter(string Id, string Label);

    static readonly TasteFilter[] TASTE_FILTERS = new[]
    {
        new TasteFilter("sweet",      "Sweet",      "🍯"),
        new TasteFilter("sour",       "Sour",       "🍋"),
        new TasteFilter("bitter",     "Bitter",     "☕"),
        new TasteFilter("spicy",      "Spicy",      "🌶"),
        new TasteFilter("strong",     "Boozy",      "🥃"),
        new TasteFilter("refreshing", "Refreshing", "🌿"),
    };

    static readonly FamilyFilter[] FAMILY_FILTERS = new[]
    {
        new FamilyFilter("all", "All"),
        new FamilyFilter("rum", "Rum"),
        new FamilyFilter("gin", "Gin"),
        new FamilyFilter("whiskey", "Whiskey"),
        new FamilyFilter("tequila", "Tequila"),
        new FamilyFilter("tiki", "Tiki"),
        new FamilyFilter("shaken", "Shaken"),
        new FamilyFilter("stirred", "Stirred"),
    };

    [SupplyParameterFromQuery] public bool Makeable { get; set; }

    string query = "";
    bool makeableOnly;
    string family = "all";
    string? color;
    HashSet<string> tastes = new();
    List<RecipeListItem>? results;
    RecipeListItem? featured;
    BarStats stats = new(0, 0, 0, 0);

    string FeaturedHref => featured is null ? "#" : $"/recipe/{featured.Id}";

    int ActiveCount =>
        (family != "all" ? 1 : 0)
        + tastes.Count
        + (color is not null ? 1 : 0)
        + (makeableOnly ? 1 : 0);

    protected override async Task OnInitializedAsync()
    {
        makeableOnly = Makeable;
        stats = await Recipes.GetBarStatsAsync(CancellationToken.None);
        var all = await Recipes.SearchAsync(new RecipeSearch(), CancellationToken.None);
        featured = all.FirstOrDefault(r => r.Name.Equals("Mai Tai", StringComparison.OrdinalIgnoreCase))
                   ?? all.FirstOrDefault();
        await Refresh();
    }

    async Task Refresh()
    {
        results = await Recipes.SearchAsync(new RecipeSearch
        {
            Query = query,
            OnlyMakeable = makeableOnly,
            Tastes = tastes.ToList(),
            ColorFamily = color,
            Family = family,
        }, CancellationToken.None);
    }

    Task OnQueryChanged(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        return Refresh();
    }

    Task ToggleMakeable()
    {
        makeableOnly = !makeableOnly;
        return Refresh();
    }

    Task ToggleTaste(string id)
    {
        if (!tastes.Add(id)) tastes.Remove(id);
        return Refresh();
    }

    Task ToggleColor(string id)
    {
        color = color == id ? null : id;
        return Refresh();
    }

    Task SetFamily(string id)
    {
        family = id;
        return Refresh();
    }

    Task ClearFilters()
    {
        family = "all";
        tastes.Clear();
        color = null;
        makeableOnly = false;
        return Refresh();
    }

    void GoMixer() => Nav.NavigateTo("/mixer");
    void OpenFeatured() { if (featured is not null) Nav.NavigateTo($"/recipe/{featured.Id}"); }
    void MixFeatured() { if (featured is not null) Nav.NavigateTo($"/mixer/{featured.Id}"); }
}
