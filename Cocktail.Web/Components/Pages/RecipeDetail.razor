@page "/recipe/{Id:int}"
@rendermode InteractiveServer
@using Cocktail.Web.Data
@using Cocktail.Web.Services
@inject RecipeService Recipes
@inject SubstitutionService Subs
@inject NavigationManager Nav

<PageTitle>@(recipe?.Name ?? "Recipe") · Sangria</PageTitle>

<div class="main">
    <div class="detail-back">
        <a class="btn btn-ghost" href="/"><AppIcon Name="arrowleft" CssClass="" Size="14" /> Back to recipes</a>
    </div>

    @if (recipe is null)
    {
        <p><em>Loading…</em></p>
    }
    else
    {
        <div class="detail-grid">
            <div>
                <div class="page-sub" style="margin-bottom: 8px">
                    @recipe.Family · @recipe.Abv ABV · @recipe.TimeMinutes min · @recipe.Difficulty
                </div>
                <h1 class="detail-title">@TitleHtml</h1>
                <p class="detail-blurb">@recipe.Description</p>

                <div class="detail-actions">
                    <button class="btn btn-papaya" type="button" @onclick="GoMixer">
                        <AppIcon Name="mic" CssClass="" Size="14" /> Make it hands-free
                    </button>
                    <button class="btn btn-ghost" type="button">
                        <AppIcon Name="heart" CssClass="" Size="14" /> Save
                    </button>
                </div>

                <div class="section-head" style="margin-top: 0">
                    <h2 class="section-title">Ingredients</h2>
                    <span class="section-sub">@recipe.Ingredients.Count items</span>
                </div>
                <div class="detail-list">
                    @foreach (var ing in recipe.Ingredients)
                    {
                        var missing = !ing.IsGarnish && !inStock.Contains(ing.IngredientName.ToLowerInvariant());
                        var subSuggestions = missing ? Subs.Suggest(ing.IngredientName) : Array.Empty<string>();
                        <div class="row">
                            <div>
                                <div class="name">@ing.IngredientName</div>
                                @if (!string.IsNullOrEmpty(ing.Sub))
                                {
                                    <div class="sub-hint">↪ @ing.Sub</div>
                                }
                                else if (subSuggestions.Count > 0)
                                {
                                    <div class="sub-hint">↪ try @string.Join(", ", subSuggestions)</div>
                                }
                            </div>
                            <span class="amount">@ing.Amount</span>
                        </div>
                    }
                </div>

                <div class="section-head" style="margin-top: 0">
                    <h2 class="section-title">The build</h2>
                    <span class="section-sub">@recipe.Steps.Count steps</span>
                </div>
                <ol class="detail-steps">
                    @{ var idx = 0; }
                    @foreach (var s in recipe.Steps)
                    {
                        idx++;
                        <li class="detail-step">
                            <div class="num">@idx</div>
                            <div>
                                <div class="title">@(string.IsNullOrEmpty(s.Title) ? $"Step {idx}" : s.Title)</div>
                                <div class="body">@s.Instruction</div>
                                @if (s.TimerSeconds is int t)
                                {
                                    <div class="timer-pill">⏱ @t s @(s.Action ?? "timer")</div>
                                }
                            </div>
                        </li>
                    }
                </ol>

                @if (!string.IsNullOrEmpty(recipe.Tip))
                {
                    <div class="tip-card" style="margin-top: 28px">
                        <div class="tip-icon">💡</div>
                        <div>
                            <h3 class="tip-title">Bartender's note</h3>
                            <p class="tip-sub">@recipe.Tip</p>
                        </div>
                        <div></div>
                    </div>
                }
            </div>

            <div class="sticky-col">
                <div class="card-art tint-@recipe.Tint detail-art">
                    <span class="deco-flag">@recipe.Family · @recipe.Glass</span>
                    <div class="detail-art-glass">
                        <GlassSvg Glass="@recipe.Glass" Liquid="@recipe.ColorHex" Garnish="@PickGarnish()" />
                    </div>
                    <div class="detail-art-foot">
                        <span>@recipe.Glass</span>
                        <span>@string.Join(" · ", recipe.Tags.Take(2))</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    Recipe? recipe;
    HashSet<string> inStock = new(StringComparer.OrdinalIgnoreCase);

    MarkupString TitleHtml { get; set; } = new("");

    protected override async Task OnInitializedAsync()
    {
        recipe = await Recipes.GetAsync(Id, CancellationToken.None);
        inStock = await Recipes.GetInStockNamesAsync(CancellationToken.None);
        TitleHtml = BuildTitle(recipe?.Name ?? "");
    }

    static MarkupString BuildTitle(string name)
    {
        var words = name.Split(' ');
        if (words.Length <= 1) return new MarkupString($"<em>{System.Net.WebUtility.HtmlEncode(name)}</em>");
        var head = string.Join(' ', words.Take(words.Length - 1));
        var tail = words[^1];
        return new MarkupString(
            System.Net.WebUtility.HtmlEncode(head) + " <em>" + System.Net.WebUtility.HtmlEncode(tail) + "</em>");
    }

    string PickGarnish() => recipe?.Glass switch
    {
        "rocks" => "orange",
        "tiki" => "flower",
        "highball" => "lime",
        "hurricane" => "flower",
        "marg" => "lime",
        _ => "lime",
    };

    void GoMixer() => Nav.NavigateTo($"/mixer/{Id}");
}
