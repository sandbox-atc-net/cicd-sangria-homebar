@* Hand-drawn SVG glassware. Glass: coupe, rocks, tiki, highball, hurricane, marg. *@

@switch ((Glass ?? "rocks").ToLowerInvariant())
{
    case "coupe":
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
            <defs>
                <linearGradient id="@gradId" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="@Liquid" stop-opacity="0.95" />
                    <stop offset="100%" stop-color="@Liquid" stop-opacity="0.7" />
                </linearGradient>
            </defs>
            <path d="M 55 65 Q 100 110 145 65 Z" fill="url(#@gradId)" />
            <path d="M 50 60 Q 100 115 150 60" stroke="rgba(0,0,0,0.55)" stroke-width="2" fill="none" stroke-linecap="round" />
            <line x1="100" y1="115" x2="100" y2="160" stroke="rgba(0,0,0,0.55)" stroke-width="2" stroke-linecap="round" />
            <ellipse cx="100" cy="162" rx="28" ry="3" stroke="rgba(0,0,0,0.55)" stroke-width="2" fill="none" />
            <path d="M 60 65 Q 65 80 75 87" stroke="rgba(255,255,255,0.6)" stroke-width="1.5" fill="none" stroke-linecap="round" />
            @if (g == "lime")
            {
                <g transform="translate(130,52)">
                    <circle r="9" fill="#c7e84f" stroke="rgba(0,0,0,0.4)" stroke-width="1.5" />
                    <path d="M 0 -6 L 0 6 M -6 0 L 6 0 M -4 -4 L 4 4 M -4 4 L 4 -4" stroke="rgba(0,0,0,0.25)" stroke-width="0.8" />
                </g>
            }
            else if (g == "cherry")
            {
                <g transform="translate(125,55)">
                    <circle r="6" fill="#c8264a" stroke="rgba(0,0,0,0.4)" stroke-width="1.5" />
                    <path d="M 0 -6 Q 6 -14 12 -16" stroke="#1f6b4a" stroke-width="2" fill="none" stroke-linecap="round" />
                </g>
            }
            else if (g == "flower")
            {
                <g transform="translate(135,55)">
                    <circle r="4" cy="-4" fill="#ff2d6f" /><circle r="4" cy="4" fill="#ff2d6f" />
                    <circle r="4" cx="-4" fill="#ff2d6f" /><circle r="4" cx="4" fill="#ff2d6f" />
                    <circle r="3" fill="#ffb347" />
                </g>
            }
        </svg>
        break;

    case "tiki":
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
            <defs>
                <linearGradient id="@gradId" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="@Liquid" stop-opacity="0.9" />
                    <stop offset="100%" stop-color="@Liquid" stop-opacity="0.7" />
                </linearGradient>
            </defs>
            <path d="M 60 60 L 56 165 Q 100 172 144 165 L 140 60 Z" fill="#8a5a3a" stroke="rgba(0,0,0,0.55)" stroke-width="2" stroke-linejoin="round" />
            <ellipse cx="100" cy="60" rx="40" ry="6" fill="url(#@gradId)" stroke="rgba(0,0,0,0.4)" stroke-width="1.5" />
            <ellipse cx="84" cy="105" rx="3" ry="5" fill="#1a1410" />
            <ellipse cx="116" cy="105" rx="3" ry="5" fill="#1a1410" />
            <path d="M 80 95 Q 84 92 88 95" stroke="#1a1410" stroke-width="1.5" fill="none" />
            <path d="M 112 95 Q 116 92 120 95" stroke="#1a1410" stroke-width="1.5" fill="none" />
            <path d="M 88 130 Q 100 138 112 130 L 110 142 Q 100 145 90 142 Z" fill="#1a1410" />
            <g transform="translate(135,40) rotate(20)">
                <line x1="0" y1="0" x2="2" y2="22" stroke="#1a1410" stroke-width="1.5" />
                <path d="M -16 0 Q 0 -10 16 0 Z" fill="#ff2d6f" stroke="rgba(0,0,0,0.5)" stroke-width="1" />
                <circle r="2" fill="#ffb347" />
            </g>
        </svg>
        break;

    case "highball":
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
            <defs>
                <linearGradient id="@gradId" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="@Liquid" stop-opacity="0.85" />
                    <stop offset="100%" stop-color="@Liquid" stop-opacity="0.65" />
                </linearGradient>
            </defs>
            <rect x="68" y="65" width="64" height="100" fill="url(#@gradId)" />
            <circle cx="78" cy="120" r="2" fill="rgba(255,255,255,0.6)" />
            <circle cx="92" cy="105" r="1.5" fill="rgba(255,255,255,0.6)" />
            <circle cx="115" cy="135" r="2" fill="rgba(255,255,255,0.6)" />
            <rect x="78" y="78" width="20" height="20" rx="3" fill="rgba(255,255,255,0.5)" stroke="rgba(255,255,255,0.7)" />
            <rect x="103" y="92" width="18" height="18" rx="3" fill="rgba(255,255,255,0.5)" stroke="rgba(255,255,255,0.7)" />
            <rect x="66" y="55" width="68" height="118" rx="2" stroke="rgba(0,0,0,0.55)" stroke-width="2" fill="none" />
            <line x1="125" y1="48" x2="115" y2="170" stroke="#ff2d6f" stroke-width="3" stroke-linecap="round" />
            @if (g == "grapefruit")
            {
                <g transform="translate(120,52)">
                    <circle r="9" fill="#ff8a9a" stroke="rgba(0,0,0,0.4)" stroke-width="1.5" />
                    <path d="M 0 -8 L 0 8 M -8 0 L 8 0" stroke="rgba(0,0,0,0.2)" stroke-width="0.7" />
                </g>
            }
            else
            {
                <g transform="translate(118,55) rotate(15)">
                    <path d="M 0 0 Q 8 -6 0 -12 Q -8 -6 0 0 Z" fill="#c7e84f" stroke="rgba(0,0,0,0.4)" stroke-width="1.5" />
                </g>
            }
        </svg>
        break;

    case "hurricane":
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
            <defs>
                <linearGradient id="@gradId" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="@Liquid" stop-opacity="0.92" />
                    <stop offset="50%" stop-color="@Liquid" stop-opacity="0.78" />
                    <stop offset="100%" stop-color="#ffb347" stop-opacity="0.85" />
                </linearGradient>
            </defs>
            <path d="M 70 65 Q 60 100 75 130 Q 80 145 80 160 L 120 160 Q 120 145 125 130 Q 140 100 130 65 Z" fill="url(#@gradId)" />
            <path d="M 65 55 Q 55 100 72 130 Q 78 148 78 165 L 122 165 Q 122 148 128 130 Q 145 100 135 55 Z" stroke="rgba(0,0,0,0.55)" stroke-width="2" fill="none" stroke-linejoin="round" />
            <line x1="100" y1="165" x2="100" y2="180" stroke="rgba(0,0,0,0.55)" stroke-width="2" />
            <ellipse cx="100" cy="182" rx="18" ry="3" stroke="rgba(0,0,0,0.55)" stroke-width="2" fill="none" />
            <g transform="translate(120,48) rotate(20)">
                <path d="M 0 0 L 14 -4 L 14 4 Z" fill="#ffd980" stroke="rgba(0,0,0,0.4)" stroke-width="1.5" />
                <path d="M -2 -6 L 2 -16 M 2 -8 L 6 -18 M 6 -10 L 10 -20" stroke="#1f6b4a" stroke-width="2" stroke-linecap="round" />
            </g>
            <g transform="translate(75,42)">
                <line x1="0" y1="0" x2="-2" y2="20" stroke="#1a1410" stroke-width="1.5" />
                <path d="M -14 0 Q 0 -8 14 0 Z" fill="#c7e84f" stroke="rgba(0,0,0,0.5)" stroke-width="1" />
            </g>
        </svg>
        break;

    case "marg":
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
            <defs>
                <linearGradient id="@gradId" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="@Liquid" stop-opacity="0.92" />
                    <stop offset="100%" stop-color="@Liquid" stop-opacity="0.7" />
                </linearGradient>
            </defs>
            <ellipse cx="100" cy="60" rx="48" ry="6" fill="rgba(255,255,255,0.85)" stroke="rgba(0,0,0,0.4)" stroke-width="1.5" />
            <path d="M 56 64 Q 100 110 144 64 Q 100 70 56 64 Z" fill="url(#@gradId)" />
            <path d="M 50 58 Q 100 118 150 58" stroke="rgba(0,0,0,0.55)" stroke-width="2" fill="none" stroke-linecap="round" />
            <line x1="100" y1="118" x2="100" y2="158" stroke="rgba(0,0,0,0.55)" stroke-width="2" />
            <ellipse cx="100" cy="162" rx="26" ry="3" stroke="rgba(0,0,0,0.55)" stroke-width="2" fill="none" />
            <g transform="translate(140,55) rotate(25)">
                <path d="M 0 0 Q 9 -7 0 -14 Q -9 -7 0 0 Z" fill="#c7e84f" stroke="rgba(0,0,0,0.4)" stroke-width="1.5" />
            </g>
        </svg>
        break;

    default: // rocks (and fallback)
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
            <defs>
                <linearGradient id="@gradId" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="@Liquid" stop-opacity="0.92" />
                    <stop offset="100%" stop-color="@Liquid" stop-opacity="0.7" />
                </linearGradient>
            </defs>
            <path d="M 60 90 L 64 155 Q 100 162 136 155 L 140 90 Z" fill="url(#@gradId)" />
            <rect x="78" y="78" width="36" height="36" rx="4" fill="rgba(255,255,255,0.45)" stroke="rgba(255,255,255,0.7)" stroke-width="1" />
            <rect x="84" y="84" width="10" height="10" rx="1" fill="rgba(255,255,255,0.5)" />
            <path d="M 58 70 L 62 158 Q 100 166 138 158 L 142 70 Z" stroke="rgba(0,0,0,0.55)" stroke-width="2" fill="none" stroke-linejoin="round" stroke-linecap="round" />
            <line x1="58" y1="70" x2="142" y2="70" stroke="rgba(0,0,0,0.55)" stroke-width="2" stroke-linecap="round" />
            @if (g == "orange")
            {
                <g transform="translate(115,68) rotate(20)">
                    <ellipse rx="14" ry="4" fill="#ffb347" stroke="rgba(0,0,0,0.4)" stroke-width="1.5" />
                </g>
            }
            else if (g == "cherry")
            {
                <g transform="translate(118,72)">
                    <circle r="6" fill="#c8264a" stroke="rgba(0,0,0,0.4)" stroke-width="1.5" />
                    <path d="M 0 -6 Q 4 -12 9 -14" stroke="#1f6b4a" stroke-width="2" fill="none" stroke-linecap="round" />
                </g>
            }
        </svg>
        break;
}

@code {
    [Parameter] public string? Glass { get; set; } = "rocks";
    [Parameter] public string Liquid { get; set; } = "#ff6b3d";
    [Parameter] public string Garnish { get; set; } = "lime";

    string g => (Garnish ?? "lime").ToLowerInvariant();
    string gradId = $"liq-{Guid.NewGuid():N}";
}
