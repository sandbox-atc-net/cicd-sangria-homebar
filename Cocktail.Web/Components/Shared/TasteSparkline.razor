@using Cocktail.Web.Services

@if (Taste is not null)
{
    <div style="display:flex;gap:@(Compact ? 3 : 4)px;align-items:flex-end;height:@(Compact ? 14 : 22)px">
        @foreach (var pair in Taste.Pairs())
        {
            var color = pair.Key switch
            {
                "sweet" => "#ffb347",
                "sour" => "#c7e84f",
                "bitter" => "#6b1d2e",
                "spicy" => "#ff2d6f",
                "strong" => "#a0521b",
                "refreshing" => "#7eb098",
                _ => "#888",
            };
            var heightPct = pair.Value * 20;
            var bg = pair.Value > 0 ? color : "var(--line)";
            var op = pair.Value > 0 ? "0.85" : "0.4";
            <div title="@pair.Key @pair.Value/5"
                 style="width:@(Compact ? 4 : 5)px;height:@heightPct%;min-height:2px;background:@bg;border-radius:2px;opacity:@op"></div>
        }
    </div>
}

@code {
    [Parameter] public TasteProfile? Taste { get; set; }
    [Parameter] public bool Compact { get; set; }
}
